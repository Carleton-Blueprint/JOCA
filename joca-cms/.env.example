# =============================================================================
# joca-cms (Strapi 5) — copy to .env and fill in values
# Never commit real secrets. Production values live in Strapi Cloud (or host).
# Generate secrets with: openssl rand -base64 32
# =============================================================================

# --- Server ---
HOST=0.0.0.0
PORT=1337
# Comma-separated list of app keys (at least 2 recommended)
APP_KEYS="toBeModified1,toBeModified2"

# --- Admin / tokens ---
ADMIN_JWT_SECRET=toBeModified
API_TOKEN_SALT=toBeModified
TRANSFER_TOKEN_SALT=toBeModified
ENCRYPTION_KEY=toBeModified

# --- Database ---
# Local default: SQLite
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production / Strapi Cloud typically uses Postgres. Example:
# DATABASE_CLIENT=postgres
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/strapi"
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false
# DATABASE_SCHEMA=public
