# =============================================================================
# joca-app (Next.js) — copy to .env and fill in values
# Never commit real secrets. Production values live in the Vercel project.
# =============================================================================

# --- Database (Supabase Postgres via Prisma) ---
# Pooled connection (pgBouncer) — used by the running app
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection — used by Prisma migrations (prisma.config.ts)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this app (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# --- Stripe ---
# Test keys for local/dev; live keys for production
STRIPE_SECRET_KEY="sk_test_..."
# From Stripe Dashboard → Developers → Webhooks (or `stripe listen` locally)
# Required in production (NODE_ENV !== development)
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Resend (email verification) ---
# Required in production. Optional locally if you skip verification (see below).
RESEND_API_KEY="re_..."

# --- Strapi CMS GraphQL ---
# Local default is http://localhost:1337/graphql when NODE_ENV=development
# Required in production
STRAPI_GRAPHQL_URL="http://localhost:1337/graphql"
# Shared with Strapi outbound webhooks (Authorization: Bearer …). Generate with: openssl rand -base64 32
STRAPI_WEBHOOK_SECRET=

# --- Dev-only escape hatch ---
# MUST be unset or "false" in production. When "true", skips email verification.
# NEXT_PUBLIC_SKIP_EMAIL_VERIFICATION="true"
